@page
@model sms_ir_api.Pages.SendOtpModel

<h2>ارسال کد تأیید</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="post" dir="rtl">
    <div class="form-group">
        <label asp-for="Otp.Mobile">شماره موبایل</label>
        <input asp-for="Otp.Mobile" class="form-control" placeholder="مثال: 09123456789" />
        <span asp-validation-for="Otp.Mobile" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">ارسال کد</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}